# 아래 둘 중 하나만 있으면 됩니다 (Anthropic 우선, 없으면 OpenAI 사용).
# 이 파일을 .env.local 로 복사한 뒤 가진 키를 넣으세요.

# Anthropic 키 (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# 또는 OpenAI 키 (https://platform.openai.com/api-keys)
# OPENAI_API_KEY=sk-...

# (선택) 모델 강제 지정. 미설정 시 Anthropic=claude-sonnet-5, OpenAI=gpt-4o.
# PREREJECT_MODEL=claude-sonnet-5
